{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentride.dev/protocol/v1/responses/permission.reply.schema.json",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "type": "object",
      "required": ["kind", "type", "payload", "requestId"],
      "properties": {
        "kind": { "const": "response" },
        "type": { "const": "permission.reply" },
        "payload": {
          "type": "object",
          "oneOf": [
            {
              "required": ["result"],
              "not": { "required": ["error"] },
              "properties": {
                "result": {
                  "type": "object",
                  "required": ["recorded"],
                  "properties": {
                    "recorded": { "type": "boolean" },
                    "effectiveScope": { "type": "string", "enum": ["once", "session", "workspace", "global"] }
                  }
                }
              }
            },
            {
              "required": ["error"],
              "not": { "required": ["result"] },
              "properties": {
                "error": { "$ref": "../defs.schema.json#/definitions/Error" }
              }
            }
          ]
        }
      }
    }
  ]
}
