{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentride.dev/protocol/v1/responses/run.start.schema.json",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "type": "object",
      "required": ["kind", "type", "payload", "requestId"],
      "properties": {
        "kind": { "const": "response" },
        "type": { "const": "run.start" },
        "payload": {
          "type": "object",
          "oneOf": [
            {
              "required": ["result"],
              "not": { "required": ["error"] },
              "properties": {
                "result": {
                  "type": "object",
                  "required": ["run", "acceptedAt"],
                  "properties": {
                    "run": {
                      "type": "object",
                      "required": ["runId", "status"],
                      "properties": {
                        "runId": { "$ref": "../defs.schema.json#/definitions/Id" },
                        "status": { "type": "string" }
                      }
                    },
                    "acceptedAt": { "$ref": "../defs.schema.json#/definitions/TimestampMs" },
                    "stream": { "type": "object", "additionalProperties": true }
                  }
                }
              }
            },
            {
              "required": ["error"],
              "not": { "required": ["result"] },
              "properties": {
                "error": { "$ref": "../defs.schema.json#/definitions/Error" }
              }
            }
          ]
        }
      }
    }
  ]
}
