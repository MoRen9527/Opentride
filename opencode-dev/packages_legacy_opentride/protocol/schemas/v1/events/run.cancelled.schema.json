{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentride.dev/protocol/v1/events/run.cancelled.schema.json",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "type": "object",
      "required": ["kind", "type", "payload"],
      "properties": {
        "kind": { "const": "event" },
        "type": { "const": "run.cancelled" },
        "payload": {
          "type": "object",
          "required": ["sessionId", "runId", "status"],
          "properties": {
            "sessionId": { "$ref": "../defs.schema.json#/definitions/Id" },
            "runId": { "$ref": "../defs.schema.json#/definitions/Id" },
            "status": { "const": "cancelled" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  ]
}
