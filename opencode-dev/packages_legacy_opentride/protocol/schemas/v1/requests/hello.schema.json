{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentride.dev/protocol/v1/requests/hello.schema.json",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "type": "object",
      "required": ["kind", "type", "payload"],
      "properties": {
        "kind": { "const": "request" },
        "type": { "const": "hello" },
        "payload": {
          "type": "object",
          "required": ["client", "capabilities"],
          "properties": {
            "client": {
              "type": "object",
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string" },
                "version": { "type": "string" }
              }
            },
            "capabilities": {
              "type": "object",
              "required": ["sse", "jsonRpc"],
              "properties": {
                "sse": { "type": "boolean" },
                "jsonRpc": { "type": "boolean" }
              }
            },
            "workspace": {
              "type": "object",
              "properties": {
                "rootUris": { "type": "array", "items": { "type": "string" } }
              }
            },
            "platform": {
              "type": "object",
              "properties": {
                "os": { "$ref": "../defs.schema.json#/definitions/Platform" },
                "arch": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
