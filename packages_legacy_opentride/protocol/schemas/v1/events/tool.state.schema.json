{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opentride.dev/protocol/v1/events/tool.state.schema.json",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "type": "object",
      "required": ["kind", "type", "payload"],
      "properties": {
        "kind": { "const": "event" },
        "type": { "const": "tool.state" },
        "payload": {
          "type": "object",
          "required": ["sessionId", "runId", "toolCall"],
          "properties": {
            "sessionId": { "$ref": "../defs.schema.json#/definitions/Id" },
            "runId": { "$ref": "../defs.schema.json#/definitions/Id" },
            "toolCall": { "$ref": "../defs.schema.json#/definitions/ToolCall" }
          }
        }
      }
    }
  ]
}
